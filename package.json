{
  "name": "opencode-mama",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "opencode-mama": "./packages/installer/src/cli.js"
  },
  "files": [
    "README.md",
    "packages/installer",
    "templates"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "tsc": "bun run --filter '*' tsc",
    "lint": "bun run --filter '*' lint && oxlint packages/installer",
    "fmt": "bun run --filter '*' fmt && oxfmt packages/installer",
    "test": "bun test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "typescript": "^6.0.3"
  }
}
